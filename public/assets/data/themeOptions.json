                "status": true,
                "reviews": [
                    {
                        "name": "Sarah Jenkins",
                        "title": "Sarah Jenkins",
                        "review": "\"I ordered a custom three-tier cake for my daughter's wedding, and it was absolutely stunning. Not only did it look like a masterpiece, but the vanilla bean sponge was moist and delicious. Highly recommended!\"",
                        "designation": "Wedding Planner",
                        "profile_image_url": "/images/placeholder/about-us/testimonial.png"
                    },
                    {
                        "name": "Michael Ross",
                        "title": "Michael Ross",
                        "review": "\"This bakery has arguably the best almond croissants in the city. The layers are perfectly flaky, and the filling is rich without being overly sweet. It has become my mandatory Sunday morning ritual.\"",
                        "designation": "Food Blogger",
                        "profile_image_url": "/images/placeholder/about-us/testimonial.png"
